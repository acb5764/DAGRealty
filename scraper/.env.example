# Copy to .env (gitignored) and fill in. Never commit the real values.
# Used by scraper/run.py and scraper/photos.py for local/manual runs.
# GitHub Actions uses repo secrets/vars instead (see .github/workflows/scrape.yml).

# Full-access admin Atlas user -- NOT the read-only user given to the public Worker.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=

# Cloudflare R2 (S3-compatible API token, Dashboard -> R2 -> Manage API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
