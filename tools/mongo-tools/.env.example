# Copy to .env (gitignored) and fill in. Never commit the real values.

# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local mongod: mongodb://localhost:27017
# Use the full-access admin DB user here -- NOT the read-only user given to the public Worker.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dagrealty
